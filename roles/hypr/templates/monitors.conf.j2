### Monitors ###
{% for monitor in monitors.screens %}
monitor = {{ monitor.name }}, {{ monitor.resolution }}@{{ monitor.refresh_rate }}, {{ monitor.position }}, {{ monitor.scale }}
{% endfor %}

### Windows ###

windowrule {
    name = Suppress maximize events for all windows
    match:class = .*
    suppress_event = maximize
}

windowrule {
    name = Do not focus empty windows
    match:class = ^$
    match:title = ^$
    match:xwayland = true
    match:float = true
    match:fullscreen = false
    match:pin = false
}

### Persistent Workspaces ###
{% set ns = namespace(count=0) %}
{% for monitor in monitors.workspaces %}
    {% for i in range(1, monitors.workspaces[monitor] + 1) %}
        {% set ns.count = ns.count + 1 %}
        workspace = {{ ns.count }}, monitor:{{ monitor }}
    {% endfor %}
{% endfor %}

decoration {
    rounding = 7

    shadow {
        enabled = false
        range = 0
    }

}

dwindle {
    pseudotile = false
    force_split = 0
    preserve_split = true
    smart_split = false
}

### Tiling ###
general {
    gaps_in = 4
    gaps_out = 7
    layout = dwindle

    border_size = 0
    #col.inactive_border = rgba(1e1e2eff)
    #col.active_border = rgba(1e1e2eff)

    allow_tearing = false
    hover_icon_on_border = true
    resize_on_border = true
    extend_border_grab_area = 10
}