#!/bin/bash

sfw_mode=false
nsfw_mode=false
for arg in "$@"; do
    case "$arg" in
        --sfw)
            sfw_mode=true
            ;;
        --nsfw)
            nsfw_mode=true
            ;;
        *)
            ;;
    esac
done

if [[ "$sfw_mode" == true && "$nsfw_mode" == true ]]; then
    echo "Cannot use --sfw and --nsfw together." >&2
    exit 1
elif [[ "$sfw_mode" == true ]]; then
    echo "SFW mode enabled - filtering out NSFW wallpapers"
    echo
elif [[ "$nsfw_mode" == true ]]; then
    echo "NSFW mode enabled - only using dot-prefixed wallpapers"
    echo
fi

wpe_installed=true
if [[ ! -d "$HOME/.local/share/Steam/steamapps/common/wallpaper_engine" ]]; then
    echo "Wallpaper Engine is not installed via Steam. Skipping WPE wallpapers."
    wpe_installed=false
else 
    if [[ ! -f "$HOME/.local/bin/linux-wallpaperengine" ]]; then
        echo "WPE detected, but linux-wallpaperengine is not installed. Please install from https://github.com/Almamu/linux-wallpaperengine"
    wpe_installed=false
    fi
fi
echo
killall linux-wallpaperengine 2>/dev/null || true

# Resolve connector names from serials (connector names can change between reboots)
get_connector_by_serial() {
    local serial="$1"
    hyprctl monitors all | awk -v serial="$serial" '
        /^Monitor / { connector = $2 }
        /serial: / && $NF == serial { print connector; exit }
    '
}

left_connector=$(get_connector_by_serial "RK2RBJA004944")
right_connector=$(get_connector_by_serial "RK2RCUA004294")

if [[ -z "$left_connector" || -z "$right_connector" ]]; then
    echo "Failed to resolve monitor connectors from serials." >&2
    exit 1
fi

for connector in "$left_connector" "$right_connector"; do
    type=null
    directory=null
    wallpapers=()
    if [[ "$wpe_installed" == true ]]; then
        type='engine'
        directory="$HOME/.local/share/Steam/steamapps/workshop/content/431960/"
    else
        type='static'
        directory="$HOME/.local/share/wallpapers/"
    fi

    echo "Scanning directory: $directory"
    shopt -s nullglob dotglob && matches=("$directory"*) && shopt -u nullglob dotglob
    if [[ ${#matches[@]} -eq 0 ]]; then
        echo "  (no matches)"
    else
        for m in "${matches[@]}"; do
            echo "  - $(basename "$m")"
        done
    fi
    # Iterate including dotfiles; we'll apply SFW/NSFW filters per-entry below
    shopt -s nullglob dotglob
    for entry in "$directory"*; do
        if [[ -d "$entry" || -f "$entry" ]]; then
            basename_entry="$(basename "$entry")"
            # Skip dot-prefixed files in SFW mode
            if [[ "$sfw_mode" == true && "$basename_entry" == .* ]]; then
                continue
            fi
            if [[ "$nsfw_mode" == true && "$basename_entry" != .* ]]; then
                continue
            fi
            wallpapers+=("$basename_entry")
        fi
    done
    shopt -u nullglob dotglob
    if [[ ${#wallpapers[@]} -eq 0 ]]; then
        echo "  (no wallpaper entries found in $directory)"
        continue
    fi

    while :; do
        wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
        if [[ " ${chosen_wallpapers[*]} " != *" $wallpaper "* ]]; then
            chosen_wallpapers+=("$wallpaper")
            break
        fi
        if [[ ${#chosen_wallpapers[@]} -ge ${#wallpapers[@]} ]]; then
            echo "All wallpapers already chosen for type $type; picking last one."
            break
        fi
    done
    echo "Chosen wallpaper for type $type: $wallpaper"

    if [[ "$type" == "engine" ]]; then
        linux-wallpaperengine --volume 0 --screen-root "$connector" --path "$directory$wallpaper"
        echo "Set screen $connector to WPE wallpaper: $wallpaper"
        notify-send -u normal "Wallpaper Changed" "Set screen $connector to WPE wallpaper: $wallpaper" --icon=$directory$wallpaper
    else
        hyprctl hyprpaper wallpaper "$connector,$directory$wallpaper"
        echo "Set screen $connector to static wallpaper: $wallpaper"
        notify-send -u normal "Wallpaper Changed" "Set screen $connector to static wallpaper: $wallpaper" --icon=$directory$wallpaper
    fi
    echo

done
