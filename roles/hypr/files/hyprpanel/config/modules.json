{
    "custom/cpu": {
        "label": "{text}",
        "icon": "",
        "execute": "~/.local/bin/hyprpanel.cpu-stats",
        "interval": 1000,
        "tooltip": "{tooltip}"
    },
    "custom/memory": {
        "label": "{text}",
        "icon": "",
        "execute": "~/.local/bin/hyprpanel.ram-stats",
        "interval": 1000,
        "tooltip": "{tooltip}"
    },
    "custom/storage": {
        "label": "{text}",
        "icon": "",
        "execute": "~/.local/bin/hyprpanel.storage-stats",
        "interval": 10000,
        "tooltip": "{tooltip}"
    }
}
