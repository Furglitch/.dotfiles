#!/usr/bin/env bash

cpu_usage=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print int(100 - $1)}')
cpu_freq=$(awk '/cpu MHz/ {sum+=$4; count++} END {printf "%.1f", sum/count/1000}' /proc/cpuinfo)

if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
    cpu_temp=$(awk '{printf "%.0f", $1/1000}' /sys/class/thermal/thermal_zone0/temp)
elif [ -f /sys/class/hwmon/hwmon0/temp1_input ]; then
    cpu_temp=$(awk '{printf "%.0f", $1/1000}' /sys/class/hwmon/hwmon0/temp1_input)
else
    cpu_temp="N/A"
fi

echo "{\"text\": \"${cpu_usage}%\", \"tooltip\": \"Usage: ${cpu_usage}%\\nTemperature: ${cpu_temp}°C\\nFrequency: ${cpu_freq} GHz\"}"