#!/usr/bin/env bash

tooltip_lines="Usage:\n"
root_usage=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')

while IFS= read -r line; do
    mountpoint=$(echo "$line" | awk '{print $NF}')
    case "$mountpoint" in
        /boot|/boot/efi|/home) continue ;;
    esac
    
    usage=$(df -h "$mountpoint" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
    info=$(df -h "$mountpoint" 2>/dev/null | awk 'NR==2 {print $3 "/" $2}')
    if [ -n "$usage" ] && [ "$usage" != "-" ]; then
        tooltip_lines="${tooltip_lines}\\n${mountpoint}: ${info} (${usage}%)"
    fi
done < <(df -hT | grep -E 'ext[2-4]|btrfs|xfs|ntfs|exfat|fuseblk')

echo "{\"text\": \"${root_usage}%\", \"tooltip\": \"${tooltip_lines}\"}"