#!/usr/bin/env bash

mem_info=$(awk '/MemTotal/ {total=$2} /MemAvailable/ {available=$2} END {printf "%.0f %.0f", total, available}' /proc/meminfo)
read -r total available <<< "$mem_info"

used=$((total - available))
if [ "$used" -lt 0 ]; then
    used=0
fi
if [ "$total" -gt 0 ]; then
    mem_percent=$((used * 100 / total))
else
    mem_percent=0
fi

format_gb() {
    local kb=$1
    if [ "$kb" -ge 1048576 ]; then
        echo "$(awk "BEGIN {printf \"%.1f\", $kb/1048576}")G"
    elif [ "$kb" -ge 1024 ]; then
        echo "$(awk "BEGIN {printf \"%.0f\", $kb/1024}")M"
    else
        echo "${kb}K"
    fi
}

swap_info=$(awk '/SwapTotal/ {total=$2} /SwapFree/ {free=$2} END {print total, free}' /proc/meminfo)
read -r swap_total swap_free <<< "$swap_info"
swap_used=$((swap_total - swap_free))

total_gb=$(format_gb "$total")
used_gb=$(format_gb "$used")
if [ "$swap_total" -gt 0 ]; then
    swap_total_gb=$(format_gb "$swap_total")
    swap_used_gb=$(format_gb "$swap_used")
    swap_text="Swap: ${swap_used_gb}/${swap_total_gb}"
else
    swap_text="Swap: N/A"
fi

echo "{\"text\": \"${mem_percent}%\", \"tooltip\": \"Usage: ${used_gb}/${total_gb} (${mem_percent}%)\\n${swap_text}\"}"