{
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "dim_white", "output": "magenta" },
    "brightColor": true,
    "key": { "width": 16, "type": "string" },
    "bar": { "width": 10, "char": { "elapsed": "#", "total": "." } },
    "percent": { "type": 3, "color": { "green": 25, "yellow": 75 } }
  },
  "logo": {
    "type": "auto",
    "color": { "1": "blue", "2": "blue" },
    "padding": {
      "top": 2
    }
  },
  "modules": [
    "break",
    "break",
    "title",
    "separator",
    { "type": "os",   "key": "OS", "format": "{pretty-name} {codename} {#2}[{version}] {#2}[{arch}]" },
    { "type": "kernel", "key": "Kernel", "format": "{sysname} {#2}[{release}]" },
	{ "type": "terminal", "key": "Terminal", "format": "{pretty-name} {#2}[{version}]" },
	{ "type": "shell", "key": "Shell", "format": "{pretty-name} {#2}[{version}]" },
    "separator",
    { "type": "cpu",    "key": "CPU",    "format": "{name} - {temperature}", "percent": { "type": 3, "green": 20, "yellow": 70 }, "temp": true  },
    { "type": "gpu",    "key": "GPU",    "format": "{name} - {temperature}", "percent": { "type": 3, "green": 20, "yellow": 70 }, "temp": true, "hideType": "integrated" },
    { "type": "memory", "key": "Memory", "format": "{percentage-bar} {used} / {total} ({percentage})", "percent": { "type": 3, "green": 30, "yellow": 80 } },
    "separator",
    { "type": "disk",  "key": "Disk", "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage}) - {name}", "percent": { "type": 3, "green": 30, "yellow": 80 }  },
    "separator",
    { "type": "localip", "key": "Local IPv4", "showIpv4": true, "showIpv6": false, "format": "{ipv4} {#2}[{ifname}]" },
    { "type": "localip", "key": "Local IPv6", "showIpv4": false, "showIpv6": true, "format": "{ipv6} {#2}[{ifname}]" },
	 { "type": "publicip", "key": "Public IP", "format": "{ip} {#2}[{location}]" },
    "break",
    "break"
  ]
}