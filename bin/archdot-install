#!/bin/bash

# archdot-install: Runs first-time setup scripts for Arch Linux installation
#
# Usage:
#     archdot-install

if [ -d ~/.archdot ]; then
    cd ~/.archdot
    git pull
else
    git clone https://github.com/Furglitch/archdot.git ~/.archdot
    cd ~/.archdot
fi

if [ ! -d ~/.ansible ]; then
    mkdir ~/.ansible
fi
if [ ! -f ~/.ansible/vault_pass ]; then
    touch ~/.ansible/vault_pass
    chmod 600 ~/.ansible/vault_pass
    read -p "Enter Ansible vault password: " VAULT_PASS
    echo "$VAULT_PASS" > ~/.ansible/vault_pass
fi
if [ -z "$VAULT_PASS" ]; then
    echo "Vault password cannot be empty. Exiting."
    exit 1
fi

read -sp "Enter sudo password: " SUDO_PASS
if [ -z "$SUDO_PASS" ]; then
    echo "Sudo password cannot be empty. Exiting."
    exit 1
fi

echo

ansible-galaxy collection install -r requirements.yml
ansible-playbook main.yml -e "ansible_become_password=${SUDO_PASS}" --vault-password-file ~/.ansible/vault_pass